# Dummy values for the production-like run on this laptop at https://dgc.localhost.
# NEVER deploy this file: the secrets are public (they are in git) and say so.
#   docker compose -f compose.prod.yml -f compose.admin.yml --env-file deploy/localhost.vars up -d --build
# For a server, copy production.vars.example and fill it with real values.

ENVIRONMENT=production
SITE_ADDRESS=dgc.localhost
FRONTEND_URL=https://dgc.localhost
MEDIA_LOCAL_BASE_URL=https://dgc.localhost/api
MEDIA_STORAGE=local
MEDIA_ORIGIN=
ACME_EMAIL=

# Host ports. Port 80 is often taken on a laptop, so this file publishes the plain-http port on
# 8080. Caddy's redirect still says https://dgc.localhost/ (the container ports are unchanged).
# Keep HTTPS_PORT at 443 (see compose.prod.yml).
HTTP_PORT=8080
HTTPS_PORT=443

# Hex, so DATABASE_URL needs no escaping.
POSTGRES_PASSWORD=7d3f0a9c1b5e48f2a6c0d9e3b1f4a8c2
# At least 32 characters, different from each other.
SECRET_KEY=local-only-not-a-secret-session-key-0001
MEDIA_SIGNING_KEY=local-only-not-a-secret-media-key-000002
